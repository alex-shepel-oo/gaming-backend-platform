POSTGRES_DB=identity_db
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity_dev_password
# Container port stays 5432 internally; POSTGRES_PORT only changes
# the host-published port, to avoid clashing with a local PostgreSQL
# install.
POSTGRES_PORT=5433

CONSUL_HTTP_PORT=8500

MAILPIT_UI_PORT=8025

IDENTITY_SERVICE_PORT=5000

API_GATEWAY_PORT=5100

PLAYER_CLIENT_PORT=8080

ADMIN_CLIENT_PORT=8081

# Consumed directly by identity-service via .NET's double-underscore config
# binding.
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025
Email__Smtp__UseStartTls=false

# HS256 signing key, [Required][MinLength(32)]. Fine for local development
# only -- generate a real secret for anything shared or deployed. Shared by
# every service that validates tokens, including economy-service (ADR-0008).
Jwt__Key=local-development-only-signing-key-please-change

ECONOMY_POSTGRES_DB=economy_db
ECONOMY_POSTGRES_USER=economy
ECONOMY_POSTGRES_PASSWORD=economy_dev_password
# Container port stays 5432 internally; ECONOMY_POSTGRES_PORT only changes
# the host-published port, kept off identity's 5433 to avoid a clash.
ECONOMY_POSTGRES_PORT=5434

ECONOMY_SERVICE_PORT=5001

NOTIFICATION_SERVICE_PORT=5003

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# How often CleanupExpiredTokensJob runs, and how many days a dispatched
# outbox row survives before platform-worker prunes it. Undelivered rows
# (processed_at IS NULL) are never touched, regardless of this threshold.
CLEANUP_JOB_INTERVAL_MINUTES=15
CLEANUP_JOB_OUTBOX_RETENTION_DAYS=7
