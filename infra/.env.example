POSTGRES_DB=identity_db
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity_dev_password
# Container port stays 5432 internally; POSTGRES_PORT only changes
# the host-published port, to avoid clashing with a local PostgreSQL
# install.
POSTGRES_PORT=5433

CONSUL_HTTP_PORT=8500

MAILPIT_UI_PORT=8025

IDENTITY_SERVICE_PORT=5000

API_GATEWAY_PORT=5100

PLAYER_CLIENT_PORT=8080

ADMIN_CLIENT_PORT=8081

# Consumed directly by identity-service via .NET's double-underscore config
# binding.
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025
Email__Smtp__UseStartTls=false

# RSA-2048 private key, PKCS#8 PEM, [Required]. Unlike the old HS256 value this
# replaces, this is NOT a working key -- an actual RSA private key is real key
# material regardless of where it's used, not a harmless arbitrary string, so
# one is not committed here. Generate your own before running `docker compose
# up` for the first time:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM | \
#     awk 'BEGIN{ORS="\\n"} {print}' | sed '$ s/\\n$/\n/'
# Paste the single-line, \n-escaped result as the value below. A .env value is
# single-line, but a PEM is inherently multi-line, so real newlines are escaped
# as literal \n sequences here; JwtSigningKeys normalizes that back before
# ImportFromPem. Only identity-service reads this (ADR-0017) -- Economy,
# Notification and the gateway validate against Jwt__JwksUri below instead.
Jwt__PrivateKeyPem=replace-with-your-own-rsa-2048-pkcs8-pem-see-comment-above

# JWKS endpoint identity-service publishes its public key(s) through; Economy,
# Notification and the gateway fetch and cache from here instead of holding
# any signing secret themselves.
Jwt__JwksUri=http://identity-service:5000/.well-known/jwks.json

ECONOMY_POSTGRES_DB=economy_db
ECONOMY_POSTGRES_USER=economy
ECONOMY_POSTGRES_PASSWORD=economy_dev_password
# Container port stays 5432 internally; ECONOMY_POSTGRES_PORT only changes
# the host-published port, kept off identity's 5433 to avoid a clash.
ECONOMY_POSTGRES_PORT=5434

ECONOMY_SERVICE_PORT=5001

NOTIFICATION_SERVICE_PORT=5003

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# How often CleanupExpiredTokensJob runs, and how many days a dispatched
# outbox row survives before platform-worker prunes it. Undelivered rows
# (processed_at IS NULL) are never touched, regardless of this threshold.
CLEANUP_JOB_INTERVAL_MINUTES=15
CLEANUP_JOB_OUTBOX_RETENTION_DAYS=7

OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318

TEMPO_QUERY_PORT=3200

PROMETHEUS_PORT=9090

LOKI_PORT=3100

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Local-only dev login for the Grafana UI, not a real secret -- same
# localhost-only caveat as every other value in this file.
GRAFANA_ADMIN_PASSWORD=grafana_dev_password
