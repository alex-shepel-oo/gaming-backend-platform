POSTGRES_DB=identity_db
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity_dev_password
# Container port stays 5432 internally; POSTGRES_PORT only changes
# the host-published port, to avoid clashing with a local PostgreSQL
# install.
POSTGRES_PORT=5433

CONSUL_HTTP_PORT=8500

MAILPIT_UI_PORT=8025

IDENTITY_SERVICE_PORT=5000

API_GATEWAY_PORT=5100

# Consumed directly by identity-service via .NET's double-underscore config
# binding.
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025
Email__Smtp__UseStartTls=false

# HS256 signing key, [Required][MinLength(32)]. Fine for local development
# only -- generate a real secret for anything shared or deployed.
Jwt__Key=local-development-only-signing-key-please-change
