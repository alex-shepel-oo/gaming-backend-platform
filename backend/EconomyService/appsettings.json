{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "gaming-backend-platform/identity",
    "Audience": "gaming-backend-platform",
    "ClockSkewSeconds": 30
  },
  "OutboxDispatcher": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 5
  }
}
