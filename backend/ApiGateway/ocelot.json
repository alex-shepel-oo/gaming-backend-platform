{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/identity/auth/{everything}",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/api/identity/auth/{everything}",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/identity/users/{everything}",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/api/identity/users/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ],
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/identity/games",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/api/identity/games",
      "UpstreamHttpMethod": [ "GET" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ],
        "AllowedScopes": []
      },
      "RouteClaimsRequirement": {
        "role": "Admin"
      }
    }
  ],
  "GlobalConfiguration": {}
}
