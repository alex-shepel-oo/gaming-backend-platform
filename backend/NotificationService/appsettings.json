{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "gaming-backend-platform/identity",
    "Audiences": [ "gbp-player", "gbp-admin" ],
    "JwksUri": "http://localhost:5000/.well-known/jwks.json",
    "ClockSkewSeconds": 30
  }
}
