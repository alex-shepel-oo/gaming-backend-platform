<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.15" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Ocelot" Version="24.1.0" />
    <PackageVersion Include="Ocelot.Provider.Consul" Version="24.1.0" />
    <PackageVersion Include="Ocelot.Provider.Polly" Version="24.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Targets net8.0/netstandard2.0: no net10.0-specific release exists yet upstream.
         Npgsql is pinned to 10.0.3 solution-wide via CPM, well above this package's own
         8.0.3 floor; the health check's surface (open a connection, run "SELECT 1;") is
         stable across that range. -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Explicit floors: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 only
         requires >=10.0.4 of these two. Without the pins, projects that
         reach EF Core solely through the Npgsql provider (no direct
         Design reference, e.g. IdentityService.Tests via ProjectReference)
         resolve 10.0.4 instead of the 10.0.10 used everywhere else. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- 7.x is a breaking async redesign (IChannel with CreateConnectionAsync/
         CreateChannelAsync/BasicPublishAsync) versus the 6.x synchronous IModel
         API most tutorials still show. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageVersion Include="Polly.Core" Version="8.6.5" />
    <!-- Transitive pin: Microsoft.AspNetCore.OpenApi 10.0.10 brings in
         Microsoft.OpenApi 2.0.0, which has GHSA-v5pm-xwqc-g5wc (stack
         overflow parsing circular schema refs). Patched in 2.7.5. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- EconomyService.Tests only: NUnit instead of xUnit, to demonstrate both
         frameworks across the two services. -->
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!-- Explicit floor: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 depends
         on this exact Npgsql version. IdentityService.Tests uses NpgsqlConnection
         directly for Respawn, so it needs a direct, pinned reference rather
         than relying on the transitive resolution through the EF provider. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
  </ItemGroup>
</Project>