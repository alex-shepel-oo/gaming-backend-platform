<Project Sdk="Microsoft.NET.Sdk.Worker">

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.Messaging\BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\BuildingBlocks.Telemetry\BuildingBlocks.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmailService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content, not EmbeddedResource: EmailTemplateRenderer re-reads these from disk on every
         call so the ConfigMap-mounted copy in Kubernetes can change without a pod restart. -->
    <Content Include="Templates\*.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Templates\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
