{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "gaming-backend-platform/identity",
    "Audiences": [ "gbp-player", "gbp-admin" ],
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "RefreshToken": {
    "LifetimeDays": 14,
    "FamilyAbsoluteLifetimeDays": 30
  },
  "Cookie": {
    "Name": "gbp_refresh",
    "Path": "/api/identity/auth",
    "RequireSecure": true,
    "SameSite": "Strict",
    "MaxAgeDays": 14
  },
  "Email": {
    "Provider": "Smtp",
    "From": "no-reply@gaming-platform.local",
    "FromDisplayName": "Gaming Backend Platform",
    "FrontendBaseUrl": "http://localhost:8080",
    "Smtp": {
      "Host": "mailpit",
      "Port": 1025,
      "UseStartTls": false
    }
  },
  "EmailVerification": {
    "CodeTtlMinutes": 20,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxResendsPerHour": 5
  },
  "PasswordReset": {
    "TokenTtlMinutes": 30,
    "CooldownSeconds": 60
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 300,
    "RegisterPermitLimit": 5,
    "RegisterWindowSeconds": 3600,
    "ConfirmEmailPermitLimit": 10,
    "ConfirmEmailWindowSeconds": 300,
    "ResendVerificationPermitLimit": 10,
    "ResendVerificationWindowSeconds": 3600,
    "RequestPasswordResetPermitLimit": 5,
    "RequestPasswordResetWindowSeconds": 3600
  }
}
