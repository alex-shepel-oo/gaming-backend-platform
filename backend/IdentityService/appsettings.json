{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "gaming-backend-platform/identity",
    "Audience": "gaming-backend-platform",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "RefreshToken": {
    "LifetimeDays": 14,
    "FamilyAbsoluteLifetimeDays": 30
  },
  "Email": {
    "Provider": "Smtp",
    "From": "no-reply@gaming-platform.local",
    "FromDisplayName": "Gaming Backend Platform",
    "Smtp": {
      "Host": "mailpit",
      "Port": 1025,
      "UseStartTls": false
    }
  },
  "EmailVerification": {
    "CodeTtlMinutes": 20,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxResendsPerHour": 5
  }
}
